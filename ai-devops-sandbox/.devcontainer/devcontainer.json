{
  "name": "ai-devops-sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "postCreateCommand": "pip install --user -r app/api/requirements.txt -r app/worker/requirements.txt -r labs/semana2-desarrollo-testing/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "hashicorp.terraform",
        "github.vscode-github-actions"
      ]
    }
  }
}
